# Default: normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly text files
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.csv   text eol=lf

# Binary files — do not modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pkl   binary
*.db    binary
*.pbix  binary
*.ipynb text eol=lf


